# Server Environment Variables Example

PORT=8080
APP_BASE_URL=http://localhost:8080
# Comma-separated exact origins, no wildcard. Production: set the deployed frontend origin.
CORS_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173
# Proxies that append to X-Forwarded-For before the API (Render = 1). Client IP = Nth entry from the right.
TRUSTED_PROXY_HOPS=1

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=moviehub

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# TMDB API
THE_MOVIE_BASE_API=https://api.themoviedb.org/3
THE_MOVIE_API_KEY=your_tmdb_api_key_here

# OMDb API (optional, https://www.omdbapi.com): IMDb and Rotten Tomatoes ratings.
# Leave empty to disable; the app then shows POPCORN and TMDB ratings only.
OMDB_API_KEY=

# Brevo Email API (https://brevo.com - 100% Free 300 emails/day)
# Get your API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=removy.official@gmail.com
BREVO_SENDER_NAME=POPCORN
# Local dev only: print verify/reset/link-code/email-change emails to the server terminal instead of sending.
# Ignored (with a boot WARN) unless CORS_ALLOWED_ORIGIN, APP_BASE_URL and FRONTEND_BASE_URL are all localhost.
DEV_MAIL_LOG=false

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=removy-private
MINIO_USE_SSL=false

# Google OAuth 2.0 Configuration
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
GOOGLE_FRONTEND_SUCCESS_URL=http://localhost:5173/
GOOGLE_FRONTEND_ERROR_URL=http://localhost:5173/login

# PLANZI <-> POPCORN account linking (leave LINK_SHARED_SECRET empty to disable)
# Secret must be >= 32 bytes; comma-separated list accepted (first signs, all verify)
LINK_SHARED_SECRET=
LINK_REMOTE_API_URL=http://localhost:8081
LINK_REMOTE_WEB_URL=http://localhost:5174
LINK_SELF_PLATFORM=popcorn

# Optional error monitoring (empty = off)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
